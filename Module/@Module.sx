use GFX.Application
use GFX.Application.Plugin as PluginProtocol
use GFX.Application.Schedule
use GFX.Canvas
use GFX.Color
use GFX.ECS
use GFX.Scene2D
use GFX.Rendering
use STD.Math
use STD.Time.Clock

public enum PanelAnchor {
    top_left
    top_center
    top_right
    center_left
    center
    center_right
    bottom_left
    bottom_center
    bottom_right
}

struct PanelSettings {
    let anchor:PanelAnchor
    let margin:Math.Vec2
    let refresh_interval:float
    let detailed:bool
}

class State {
    let settings:PanelSettings
    var elapsed:float
    var frames:int
    var display:ECS.Entity
    var clock:Clock

    init(settings:PanelSettings) {
        self.settings = settings
        self.elapsed = 0.0
        self.frames = 0
        self.display = ECS.Entity()
        self.clock = Clock()
    }
}

public struct FPSPanel:PluginProtocol {
    struct Settings {
        var anchor:PanelAnchor
        var margin:Math.Vec2
        var refresh_interval:float

        init() {
            self.anchor = PanelAnchor.bottom_right
            self.margin = Math.Vec2(16.0)
            self.refresh_interval = 0.25
        }
    }

    private let settings:PanelSettings

    init(settings:FPSPanel.Settings = FPSPanel.Settings()) {
        validate_panel(settings.margin, settings.refresh_interval, "FPS panel")
        self.settings = PanelSettings(
            anchor:settings.anchor,
            margin:settings.margin,
            refresh_interval:settings.refresh_interval,
            detailed:false
        )
    }

    func id() str { return "GFX.Stats.Panel" }

    func build(application:&Application) {
        install_panel(application, self.settings)
    }
}

public struct PerformancePanel:PluginProtocol {
    struct Settings {
        var anchor:PanelAnchor
        var margin:Math.Vec2
        var refresh_interval:float

        init() {
            self.anchor = PanelAnchor.top_left
            self.margin = Math.Vec2(16.0)
            self.refresh_interval = 0.25
        }
    }

    private let settings:PanelSettings

    init(settings:PerformancePanel.Settings = PerformancePanel.Settings()) {
        validate_panel(settings.margin, settings.refresh_interval, "performance panel")
        self.settings = PanelSettings(
            anchor:settings.anchor,
            margin:settings.margin,
            refresh_interval:settings.refresh_interval,
            detailed:true
        )
    }

    func id() str { return "GFX.Stats.Panel" }

    func build(application:&Application) {
        install_panel(application, self.settings)
    }
}

func install_panel(application:&Application, settings:PanelSettings) {
    application.add_plugin(Scene2D.Plugin())
    application.add_resource(State(settings))
    // Keep the high-layer overlay after application-owned startup scene content.
    application.add_after_system(Schedule.startup, create_counter)
    application.add_system(Schedule.update, update_counter)
    application.add_system(Schedule.shutdown, stop_counter)
}

func validate_panel(margin:Math.Vec2, refresh_interval:float, subject:str) {
    if margin.x < 0.0 || margin.y < 0.0 {
        panic("GFX.Stats $(subject) margins must not be negative")
    }
    if refresh_interval <= 0.0 {
        panic("GFX.Stats $(subject) refresh interval must be positive")
    }
}

func anchor_point(anchor:PanelAnchor) Math.Vec2 {
    if anchor == PanelAnchor.top_left { return Math.Vec2() }
    if anchor == PanelAnchor.top_center { return Math.Vec2(0.5, 0.0) }
    if anchor == PanelAnchor.top_right { return Math.Vec2(1.0, 0.0) }
    if anchor == PanelAnchor.center_left { return Math.Vec2(0.0, 0.5) }
    if anchor == PanelAnchor.center { return Math.Vec2(0.5) }
    if anchor == PanelAnchor.center_right { return Math.Vec2(1.0, 0.5) }
    if anchor == PanelAnchor.bottom_left { return Math.Vec2(0.0, 1.0) }
    if anchor == PanelAnchor.bottom_center { return Math.Vec2(0.5, 1.0) }
    return Math.Vec2(1.0)
}

func anchor_offset(anchor:PanelAnchor, margin:Math.Vec2) Math.Vec2 {
    let point = anchor_point(anchor)
    var x = 0.0
    var y = 0.0
    if point.x == 0.0 { x = margin.x }
    else if point.x == 1.0 { x = -margin.x }
    if point.y == 0.0 { y = margin.y }
    else if point.y == 1.0 { y = -margin.y }
    return Math.Vec2(x, y)
}

func fps_canvas(fps:int) Canvas {
    var canvas = Canvas()
    let label = "$(fps) FPS"
    var style = Canvas.TextStyle(
        size:18.0,
        color:Color.white(),
        alignment:Canvas.TextAlignment.center
    )
    let metrics = canvas.measure_text(label, style)
    let text_position = Math.Vec2(58.0, (34.0 - metrics.height) * 0.5)
    canvas.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(), Math.Vec2(116.0, 34.0), 8.0),
            Canvas.Fill.solid(Color.black().with_alpha(0.72))
        )
        painter.text(label, text_position, style)
    })
    return canvas
}

func decimal_tenths(value:int) str {
    return "$(value / 10).$(value % 10)"
}

func performance_canvas(fps:int, frame_tenths:int, stats:Rendering.Stats) Canvas {
    var labels:str[] = []
    labels.append("FPS")
    labels.append("FRAME")
    labels.append("COLOR DRAWS")
    labels.append("SHADOW DRAWS")
    labels.append("COLOR TRIS")
    labels.append("SHADOW TRIS")
    labels.append("PIPELINE BINDS")
    labels.append("GPU PASSES")
    labels.append("UNIFORMS")
    labels.append("TEXTURES")

    var values:str[] = []
    values.append("$(fps)")
    values.append(decimal_tenths(frame_tenths) + " ms")
    values.append("$(stats.color_draw_calls())")
    values.append("$(stats.shadow_draw_calls())")
    values.append("$(stats.color_triangles())")
    values.append("$(stats.shadow_triangles())")
    values.append("$(stats.pipeline_bindings())")
    values.append("$(stats.render_passes())")
    values.append("$((stats.uniform_bytes() + 1023) / 1024) KiB")
    values.append("$(stats.texture_bindings())")

    var canvas = Canvas()
    canvas.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(), Math.Vec2(252.0, 252.0), 9.0),
            Canvas.Fill.solid(Color.black().with_alpha(0.82))
        )
        painter.stroke(
            Canvas.Rect(Math.Vec2(0.5), Math.Vec2(251.0, 251.0), 9.0),
            Canvas.Stroke(Color.cyan_400().with_alpha(0.48), 1.0)
        )
        painter.text(
            "GFX PERFORMANCE",
            Math.Vec2(16.0, 11.0),
            Canvas.TextStyle(size:14.0, color:Color.cyan_300(), weight:Canvas.TextWeight.bold)
        )
        painter.stroke(
            Canvas.Line(Math.Vec2(16.0, 38.0), Math.Vec2(236.0, 38.0)),
            Canvas.Stroke(Color.slate_500().with_alpha(0.5), 1.0)
        )
        var index = 0
        while index < labels.count() {
            let y = 48.0 + index as float * 19.0
            painter.text(
                labels[index],
                Math.Vec2(16.0, y),
                Canvas.TextStyle(size:13.0, color:Color.slate_300())
            )
            painter.text(
                values[index],
                Math.Vec2(236.0, y),
                Canvas.TextStyle(size:13.0, color:Color.white(), alignment:Canvas.TextAlignment.end)
            )
            index++
        }
    })
    return canvas
}

func display_width(settings:PanelSettings) int {
    if settings.detailed { return 252 }
    return 116
}

func display_height(settings:PanelSettings) int {
    if settings.detailed { return 252 }
    return 34
}
func display_canvas(settings:PanelSettings, fps:int, frame_tenths:int, stats:Rendering.Stats) Canvas {
    if settings.detailed { return performance_canvas(fps, frame_tenths, stats) }
    return fps_canvas(fps)
}

func create_counter(state:&State, world:&ECS.World, renderer:@Rendering.Renderer) {
    state.display = world.spawn(ECS.EntityRecipe()
        ..with(Scene2D.Transform(
            position:anchor_offset(state.settings.anchor, state.settings.margin)
        ))
        ..with(Scene2D.Canvas(
            display_canvas(state.settings, 0, 0, renderer.stats()),
            display_width(state.settings),
            display_height(state.settings)
        )
            ..anchor = anchor_point(state.settings.anchor)
            ..pivot = anchor_point(state.settings.anchor)
            ..space = Scene2D.CanvasSpace.viewport
            ..layer = 100
        )
    )
    state.clock.tick()
}

func update_counter(state:&State, world:&ECS.World, renderer:@Rendering.Renderer) {
    state.elapsed += state.clock.tick()
    state.frames++
    if state.elapsed < state.settings.refresh_interval { return }

    let fps = Math.round(state.frames as float / state.elapsed) as int
    let frame_tenths = Math.round(state.elapsed * 10000.0 / state.frames as float) as int
    world.update<Scene2D.Canvas>(state.display, func(display:&Scene2D.Canvas) {
        var canvas = display_canvas(state.settings, fps, frame_tenths, renderer.stats())
        display.replace(canvas)
    })
    state.elapsed = 0.0
    state.frames = 0
}

func stop_counter(application:Application) {
    var resources = application.resources()
    var removed = resources.remove<State>()
    assert(removed != null)
}

contribute GFX.Plugins {
    public use GFX.Stats.FPSPanel
    public use GFX.Stats.PanelAnchor as FPSPanelAnchor
    public use GFX.Stats.PerformancePanel
    public use GFX.Stats.PanelAnchor as PerformancePanelAnchor
}
