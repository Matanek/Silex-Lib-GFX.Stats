use GFX.Application
use GFX.Plugins
use GFX.Stats

func stop_after_first_frame(controller:&Application.Controller) {
    controller.stop()
}

func main() {
    Application()
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "GFX.Stats performance panel"
            ..width = 640
            ..height = 360
        ))
        ..add_plugin(Stats.PerformancePanel(Stats.PerformancePanel.Settings()
            ..anchor = Stats.PanelAnchor.top_left
        ))
        ..add_after_system(Application.Schedule.render, stop_after_first_frame)
        ..run()
}
