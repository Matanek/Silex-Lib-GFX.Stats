use GFX.Application
use GFX.Plugins
use GFX.Stats

func stop_after_first_frame(controller:&Application.Controller) {
    controller.stop()
}

func main() {
    Application()
        ..add_plugin(Plugins.Window(Plugins.Window.Settings()
            ..title = "GFX.Stats FPS panel"
            ..width = 480
            ..height = 270
        ))
        ..add_plugin(Stats.FPSPanel(Stats.FPSPanel.Settings()
            ..anchor = Stats.PanelAnchor.bottom_right
        ))
        ..add_after_system(Application.Schedule.render, stop_after_first_frame)
        ..run()
}
